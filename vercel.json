{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "routes": [
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/(img|brand)/(.*)", "headers": { "Cache-Control": "public, max-age=604800, stale-while-revalidate=2592000" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/(assets|img|brand)/.*", "status": 404, "headers": { "Cache-Control": "no-store" } },
    { "src": "/api/.*", "status": 404, "headers": { "Cache-Control": "no-store" } },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
